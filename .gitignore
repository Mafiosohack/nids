# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/

# Virtual environment
venv/
env/
ENV/

# Logs
logs/
*.log

# Model files (regenerable via training scripts)
models/*.pkl
models/*.h5
models/*.pt
models/*.json

# ...but SHIP the trained CIC-IDS2017 models (~7 MB) so a fresh clone runs
# without needing the ~2 GB dataset. Retraining regenerates these in place.
!models/cicids_flow.pkl
!models/cicids_flow_meta.json
!models/cicids_live.pkl
!models/cicids_live_encoder.pkl
!models/cicids_live_meta.json

# Dataset / capture files
data/*.csv
data/*.json
data/**/*.csv
*.pcap

# CIC-IDS2017 raw dataset (large; download separately)
MachineLearningCVE/
TrafficLabelling_/
data/cicids2017/
*.zip
*.md5

# Runtime databases
# NOTE: nids_users.db was committed before this rule existed and is still
# reachable in git history (blob 2d36330, commits 53d177f / 0a744d8). Adding a
# path here stops FUTURE commits; it does not remove what is already published.
*.db
*.sqlite
*.sqlite3

# ── Site-specific security config — NEVER commit ────────────────────────────
# assets.json is the real inventory: internal IPs, gateway/host MAC addresses,
# per-host listening-port snapshots (a complete attack-surface map), permitted
# egress, and which host pairs may hold a shell. Publishing it hands an attacker
# the reconnaissance they would otherwise have to run a scan to get — and the
# scan is the part this NIDS is built to catch.
# Commit assets.example.json instead; it holds documentation-only placeholders.
assets.json
assets.*.json
!assets.example.json

# Baseline output from baseline_assets.py — same content, same reason.
baseline.json
*.assets.json

# Learned per-host profiles (detection/host_profile.py). Not declared config
# but observed fact, and strictly worse to leak than assets.json: it is a
# communication graph of who talks to whom, on which ports, at which hours,
# and how much data moves — the map an attacker draws AFTER getting inside.
host_profiles.json
host_profiles.json.tmp
*.profiles.json

# Per-deployment secrets, generated on first start (2026-10-31 audit).
# sensor_keys.json: one key per sensor; whoever holds the "host" key can vouch
# for SSH logins and so silence the interactive-shell rule.
# tls/: the server's private key - with it, anyone can impersonate the
# dashboard to sensors and browsers that pinned this certificate.
sensor_keys.json
sensor_keys.json.tmp
tls/
*.pem

# Captured traffic (may contain credentials, session tokens, real payloads)
*.pcapng
*.cap

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Environment variables
.env

# Variant env files (.env.local, .env.prod, ...) - keep a placeholder-only
# .env.example committable.
.env.*
!.env.example

# Private keys in any format, not just PEM.
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Claude Code per-machine settings: the permission allow-list records every
# approved command verbatim, including any password typed into one. Ignored
# globally on the dev box, but a fresh clone elsewhere has no global rule.
.claude/settings.local.json

# NSL-KDD legacy dataset (removed 2026-11-09; restore steps in
# docs/LEGACY_NSL_KDD.md). Kept out so restoring it locally does not re-add 22 MB.
data/raw/
