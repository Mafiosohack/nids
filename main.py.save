===_"""
REAL-TIME NETWORK INTRUSION DETECTION SYSTEM (NIDS)
Hybrid IDS: Signature + Anomaly + Behavioral + Correlation
"""

import threading
import time
import numpy as np
from datetime import datetime
from collections import defaultdict, deque
from typing import Dict, Optional, Deque
from pathlib import Path

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

try:
    from scapy.all import sniff, IP, TCP, UDP, ICMP
    SCAPY_AVAILABLE = True
except ImportError:
    SCAPY_AVAILABLE = False

try:
    import joblib
    JOBLIB_AVAILABLE = True
except ImportError:
    JOBLIB_AVAILABLE = False

# ================= CONFIG =================
NETWORK_INTERFACE = "ens37"

PORT_SCAN_THRESHOLD = 5
PORT_SCAN_WINDOW = 5

STEALTH_SCAN_THRESHOLD = 15
STEALTH_SCAN_WINDOW = 60

DDOS_PACKET_RATE_THRESHOLD = 200
DDOS_WINDOW = 3

SYN_FLOOD_SYN_THRESHOLD = 100
SYN_FLOOD_WINDOW = 5
SYN_ACK_RATIO_LIMIT = 5

BRUTE_FORCE_THRESHOLD = 8
BRUTE_FORCE_WINDOW = 60

UDP_AMP_PORTS = {53, 123, 1900, 11211, 19, 17}
UDP_AMP_THRESHOLD = 50
UDP_AMP_WINDOW = 10

MAX_ALERTS_STORED = 200
CORRELATION_EVENT_LIMIT = 15

MODEL_PATH = Path("model.pkl")
ENCODER_PATH = Path("encoder.pkl")

# ================= GLOBAL STATE =================
alerts_lock = threading.Lock()
alerts: Deque[Dict] = deque(maxlen=MAX_ALERTS_STORED)

scan_tracker = defaultdict(lambda: {"ports": set(), "first_seen": None})
stealth_tracker = defaultdict(lambda: {"ports": set(), "timestamps": []})
ddos_tracker = defaultdict(lambda: {"timestamps": []})
syn_tracker = defaultdict(lambda: {"syn": 0, "ack": 0, "timestamps": []})
bruteforce_tracker = defaultdict(lambda: {"attempts": 0, "timestamps": []})
udp_amp_tracker = defaultdict(lambda: {"timestamps": []})

correlation_tracker = defaultdict(lambda: {"events": []})
correlation_lock = threading.Lock()

system_stats = {
    "packets_captured": 0,
    "alerts_generated": 0,
    "start_time": None,
    "running": False
}

sniffer_thread: Optional[threading.Thread] = None
sniffer_stop_event = threading.Event()

# ================= ML MODEL =================
ml_model = None
ml_encoder = None

def load_ml_model():
    global ml_model, ml_encoder
    if not JOBLIB_AVAILABLE:
        print("[ML] joblib not available. ML detection disabled.")
        return
    if MODEL_PATH.exists():
        try:
            ml_model = joblib.load(MODEL_PATH)
            print("[ML] Model loaded successfully.")
        except Exception as e:
            print(f"[ML] Failed to load model: {e}")
    else:
        print("[ML] No model file found. ML detection will be skipped.")
    if ENCODER_PATH.exists():
        try:
            ml_encoder = joblib.load(ENCODER_PATH)
            print("[ML] Encoder loaded successfully.")
        except Exception as e:
            print(f"[ML] Failed to load encoder: {e}")

def extract_features(packet) -> Optional[np.ndarray]:
    """Extract numerical features from a packet for ML inference."""
    try:
        if not packet.haslayer(IP):
            return None
        ip = packet[IP]
        proto = ip.proto
        pkt_len = len(packet)
        ttl = ip.ttl

        src_port, dst_port, flags = 0, 0, 0
        if packet.haslayer(TCP):
            src_port = packet[TCP].sport
            dst_port = packet[TCP].dport
            flags = int(packet[TCP].flags)
        elif packet.haslayer(UDP):
            src_port = packet[UDP].sport
            dst_port = packet[UDP].dport

        return np.array([[proto, pkt_len, ttl, src_port, dst_port, flags]])
    except Exception:
        return None

def run_ml_detection(packet, src: str, dst: str):
    if ml_model is None:
        return
    features = extract_features(packet)
    if features is None:
        return
    try:
        prediction = ml_model.predict(features)[0]
        if ml_encoder:
            label = ml_encoder.inverse_transform([prediction])[0]
        else:
            label = str(prediction)

        if label.lower() not in {"normal", "benign", "0"}:
            generate_alert(
                "ML Anomaly",
                "high",
                src,
                dst,
                "IP",
                f"ML model flagged traffic as '{label}' from {src} → {dst}",
                {"predicted_label": label}
            )
    except Exception as e:
        print(f"[ML] Inference error: {e}")

# ================= ALERT =================
def generate_alert(
    alert_type: str,
    severity: str,
    src: str,
    dst: Optional[str],
    protocol: str,
    message: str,
    details: Optional[Dict] = None,
    _from_correlation: bool = False
):
    with alerts_lock:
        alert_id = system_stats["alerts_generated"] + 1
        alert = {
            "id": alert_id,
            "type": alert_type,
            "severity": severity,
            "src": src,
            "dst": dst,
            "protocol": protocol,
            "message": message,
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "details": details or {}
        }
        alerts.append(alert)
        system_stats["alerts_generated"] += 1

    print(f"[{severity.upper()}] {alert_type} → {message}")

    if not _from_correlation:
        with correlation_lock:
            correlation_tracker[src]["events"].append(alert_type)
        correlate_events(src)

# ================= CORRELATION ENGINE =================
def correlate_events(src: str):
    with correlation_lock:
        events = list(correlation_tracker[src]["events"])

    if len(events) > CORRELATION_EVENT_LIMIT:
        with correlation_lock:
            correlation_tracker[src]["events"].clear()
        return

    unique = set(events)

    if "Port Scan" in unique and "Brute Force Attempt" in unique:
        generate_alert(
            "Attack Chain",
            "critical",
            src,
            None,
            "Multiple",
            f"Attack chain detected from {src}: Port Scan followed by Brute Force",
            {"events": list(unique)},
            _from_correlation=True
        )
        with correlation_lock:
            correlation_tracker[src]["events"].clear()
        return

    if "Port Scan" in unique and "SYN Flood" in unique:
        generate_alert(
            "Coordinated Attack",
            "critical",
            src,
            None,
            "Multiple",
            f"Coordinated attack from {src}: Port Scan combined with SYN Flood",
            {"events": list(unique)},
            _from_correlation=True
        )
        with correlation_lock:
            correlation_tracker[src]["events"].clear()
        return

    if len(unique) >= 3:
        generate_alert(
            "Multi-Vector Attack",
            "critical",
            src,
            None,
            "Multiple",
            f"Multi-vector attack detected from {src}: {', '.join(unique)}",
            {"events": list(unique)},
            _from_correlation=True
        )
        with correlation_lock:
            correlation_tracker[src]["events"].clear()

# ================= SIGNATURE DETECTION =================
def check_tcp_signature(packet) -> Optional[str]:
    if not packet.haslayer(TCP):
        return None
    flags = int(packet[TCP].flags)

    if flags == 0x02:
        return "SYN Scan"
    if flags == 0x00:
        return "NULL Scan"
    if flags & 0x29 == 0x29:
        return "XMAS Scan"
    if flags == 0x01:
        return "FIN Scan"
    if flags == 0x03:
        return "FIN+SYN Scan"

    return None

# ================= DETECTION MODULES =================
def detect_port_scan(src: str, dst: str, port: int):
    tracker = scan_tracker[src]
    now = time.time()

    if not tracker["first_seen"]:
        tracker["first_seen"] = now

    tracker["ports"].add(port)

    if now - tracker["first_seen"] > PORT_SCAN_WINDOW:
        tracker["ports"].clear()
        tracker["first_seen"] = now
        return

    if len(tracker["ports"]) > PORT_SCAN_THRESHOLD:
        generate_alert(
            "Port Scan",
            "high",
            src,
            dst,
            "TCP",
            f"Port scan detected: {src} scanned {len(tracker['ports'])} ports on {dst} within {PORT_SCAN_WINDOW}s",
            {"ports_scanned": len(tracker["ports"]), "window_seconds": PORT_SCAN_WINDOW}
        )
        tracker["ports"].clear()
        tracker["first_seen"] = now


def detect_stealth_scan(src: str, port: int):
    tracker = stealth_tracker[src]
    now = time.time()

    tracker["ports"].add(port)
    tracker["timestamps"].append(now)
    tracker["timestamps"] = [t for t in tracker["timestamps"] if now - t < STEALTH_SCAN_WINDOW]

    if len(tracker["ports"]) >= STEALTH_SCAN_THRESHOLD:
        generate_alert(
            "Stealth Scan",
            "medium",
            src,
            None,
            "TCP",
            f"Stealth scan detected: {src} slowly probed {len(tracker['ports'])} ports over {STEALTH_SCAN_WINDOW}s",
            {"ports_scanned": len(tracker["ports"]), "window_seconds": STEALTH_SCAN_WINDOW}
        )
        tracker["ports"].clear()
        tracker["timestamps"].clear()


def detect_ddos(src: str, dst: str):
    tracker = ddos_tracker[src]
    now = time.time()

    tracker["timestamps"].append(now)
    tracker["timestamps"] = [t for t in tracker["timestamps"] if now - t < DDOS_WINDOW]

    if len(tracker["timestamps"]) > DDOS_PACKET_RATE_THRESHOLD:
        generate_alert(
            "DDoS",
            "critical",
            src,
            dst,
            "Multiple",
            f"DDoS detected: {src} sent {len(tracker['timestamps'])} packets in {DDOS_WINDOW}s targeting {dst}",
            {"packet_count": len(tracker["timestamps"]), "window_seconds": DDOS_WINDOW}
        )
        tracker["timestamps"].clear()


def detect_syn_flood(src: str, dst: str):
    tracker = syn_tracker[src]
    tracker["syn"] += 1

    if tracker["syn"] > SYN_FLOOD_SYN_THRESHOLD:
        ratio = tracker["syn"] / max(tracker["ack"], 1)
        if ratio > SYN_ACK_RATIO_LIMIT:
            generate_alert(
                "SYN Flood",
                "critical",
                src,
                dst,
                "TCP",
                f"SYN flood from {src} → {dst}: {tracker['syn']} SYNs, SYN/ACK ratio={ratio:.1f}",
                {"syn_count": tracker["syn"], "ack_count": tracker["ack"], "ratio": round(ratio, 2)}
            )
            tracker["syn"] = 0
            tracker["ack"] = 0


def detect_udp_amplification(src: str, dst: str, dst_port: int, pkt_len: int):
    if dst_port not in UDP_AMP_PORTS:
        return

    tracker = udp_amp_tracker[src]
    now = time.time()

    tracker["timestamps"].append(now)
    tracker["timestamps"] = [t for t in tracker["timestamps"] if now - t < UDP_AMP_WINDOW]

    if len(tracker["timestamps"]) > UDP_AMP_THRESHOLD:
        generate_alert(
            "UDP Amplification",
            "high",
            src,
            dst,
            "UDP",
            f"UDP amplification detected from {src} → {dst}:{dst_port}, {len(tracker['timestamps'])} requests in {UDP_AMP_WINDOW}s",
            {
                "dst_port": dst_port,
                "request_count": len(tracker["timestamps"]),
                "packet_size": pkt_len,
                "window_seconds": UDP_AMP_WINDOW
            }
        )
        tracker["timestamps"].clear()


def detect_bruteforce(src: str, dst: str, port: int):
    if port not in {22, 21, 3389, 23, 25, 110, 143, 3306, 5432}:
        return

    tracker = bruteforce_tracker[src]
    now = time.time()

    tracker["attempts"] += 1
    tracker["timestamps"].append(now)
    tracker["timestamps"] = [t for t in tracker["timestamps"] if now - t < BRUTE_FORCE_WINDOW]

    if tracker["attempts"] >= BRUTE_FORCE_THRESHOLD:
        generate_alert(
            "Brute Force Attempt",
            "high",
            src,
            dst,
            "TCP",
            f"Brute force from {src} → {dst}:{port}: {tracker['attempts']} attempts in {BRUTE_FORCE_WINDOW}s",
            {
                "port": port,
                "attempt_count": tracker["attempts"],
                "window_seconds": BRUTE_FORCE_WINDOW
            }
        )
        tracker["attempts"] = 0
        tracker["timestamps"].clear()

# ================= PACKET PROCESSOR =================
def process_packet(packet):
    system_stats["packets_captured"] += 1

    if not packet.haslayer(IP):
        return

    src = packet[IP].src
    dst = packet[IP].dst

    detect_ddos(src, dst)
    run_ml_detection(packet, src, dst)

    if packet.haslayer(TCP):
        tcp = packet[TCP]
        dport = tcp.dport
        flags = int(tcp.flags)

        sig = check_tcp_signature(packet)

        if flags & 0x02:
            detect_port_scan(src, dst, dport)
            detect_stealth_scan(src, dport)
            detect_syn_flood(src, dst)

            if sig:
                generate_alert(
                    "Signature Confirmation",
                    "low",
                    src,
                    dst,
                    "TCP",
                    f"TCP signature '{sig}' detected from {src} → {dst}:{dport}",
                    {"signature": sig, "dst_port": dport, "flags": flags}
                )

        if flags & 0x10:
            syn_tracker[src]["ack"] += 1

        detect_bruteforce(src, dst, dport)

    elif packet.haslayer(UDP):
        udp = packet[UDP]
        detect_udp_amplification(src, dst, udp.dport, len(packet))

    elif packet.haslayer(ICMP):
        pass

# ================= SNIFFER THREAD =================
def start_sniffer():
    if not SCAPY_AVAILABLE:
        print("[SNIFFER] Scapy not available. Cannot start capture.")
        return
    print(f"[SNIFFER] Starting on interface: {NETWORK_INTERFACE}")
    sniff(
        iface=NETWORK_INTERFACE,
        prn=process_packet,
        store=False,
        stop_filter=lambda _: sniffer_stop_event.is_set()
    )
    print("[SNIFFER] Stopped.")

# ================= FASTAPI APP =================
app = FastAPI(
    title="NIDS API",
    description="Real-Time Network Intrusion Detection System",
    version="2.0.0"
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"]
)

# ================= API ENDPOINTS =================
@app.get("/health")
def health():
    return {
        "status": "ok",
        "scapy_available": SCAPY_AVAILABLE,
        "ml_model_loaded": ml_model is not None,
        "ml_encoder_loaded": ml_encoder is not None,
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }


@app.get("/status")
def status():
    uptime = None
    if system_stats["start_time"]:
        uptime = round(time.time() - system_stats["start_time"], 1)
    return {
        "running": system_stats["running"],
        "packets_captured": system_stats["packets_captured"],
        "alerts_generated": system_stats["alerts_generated"],
        "alerts_stored": len(alerts),
        "uptime_seconds": uptime,
        "interface": NETWORK_INTERFACE
    }


@app.get("/alerts")
def get_alerts(limit: int = 50, severity: Optional[str] = None):
    with alerts_lock:
        result = list(alerts)
    if severity:
        result = [a for a in result if a["severity"].lower() == severity.lower()]
    return result[-limit:]

@app.post("/alert")
def receive_external_alert(alert: dict):
    src = alert.get("src")
    dst = alert.get("dst")
    proto = alert.get("proto")
    message = alert.get("message", "Suspicious activity")

    alert_type = "network_anomaly"
    severity = "high"

    with alerts_lock:
        alert_id = system_stats["alerts_generated"] + 1

        new_alert = {
            "id": alert_id,
            "type": alert_type,
            "severity": severity,
            "src": src,
            "dst": dst,
            "protocol": proto,
            "message": message,
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "details": {}
        }

        alerts.append(new_alert)
        system_stats["alerts_generated"] += 1

    print(f"📥 External alert received: {new_alert}")

    return {"status": "ok"}


@app.post("/control/start")
def control_start():
    global sniffer_thread

    if system_stats["running"]:
        raise HTTPException(status_code=400, detail="Sniffer is already running.")

    if not SCAPY_AVAILABLE:
        raise HTTPException(status_code=503, detail="Scapy is not installed. Cannot capture packets.")

    sniffer_stop_event.clear()
    sniffer_thread = threading.Thread(target=start_sniffer, daemon=True)
    sniffer_thread.start()
    system_stats["running"] = True
    system_stats["start_time"] = time.time()

    return {"status": "started", "interface": NETWORK_INTERFACE}


@app.post("/control/stop")
def control_stop():
    if not system_stats["running"]:
        raise HTTPException(status_code=400, detail="Sniffer is not running.")

    sniffer_stop_event.set()
    system_stats["running"] = False

    return {"status": "stopped"}


# ================= STARTUP =================
@app.on_event("startup")
def on_startup():
    load_ml_model()
    print("[NIDS] System initialized. Use POST /control/start to begin capture.")


# ================= ENTRY POINT =================
if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=False)
